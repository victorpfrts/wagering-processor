{
  "name": "wagering-processor",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v",
    "migration:up": "bun src/infrastructure/db/migrate.ts up",
    "migration:down": "bun src/infrastructure/db/migrate.ts down",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@mikro-orm/core": "^7.2.9",
    "@mikro-orm/migrations": "^7.2.9",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.9",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "decimal.js": "^10.6.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
